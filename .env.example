# SIVAM — plantilla de configuración
# Copiar como .env solo para desarrollo local. Nunca subir .env al repositorio.

# Obligatorio en producción: conexión PostgreSQL institucional.
# Ejemplo: postgresql://USUARIO:CONTRASENA@HOST:5432/BASE?sslmode=require
DATABASE_URL=

# Obligatorio en producción: valor aleatorio largo, único y secreto.
SECRET_KEY=

# Producción: false. Desarrollo local: true.
FLASK_DEBUG=false

# Solo si se ejecuta con `python app.py`. Gunicorn/Nginx normalmente lo define.
PORT=8000

# Datos que se muestran en la política de tratamiento de datos.
CONTACTO_PROTECCION_DATOS=
TELEFONO_PROTECCION_DATOS=
DIRECCION_PROTECCION_DATOS=

# Solo para desarrollo local con SQLite. No usar en producción.
# SQLITE_PATH=data/clinica.db
